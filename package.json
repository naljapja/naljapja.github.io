{
  "name": "naljapja-checks",
  "private": true,
  "description": "Development-only regression and local Firestore rules checks; the website has no build step.",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "test": "node --test --test-isolation=none tests/host-state.test.cjs tests/date-state.test.cjs tests/legacy-recovery.test.cjs tests/lightweight-ux.test.cjs",
    "test:rules": "firebase emulators:exec --project demo-naljapja-tests --only firestore \"node --test --test-isolation=none tests/security-rules.test.cjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.34.0"
  }
}
